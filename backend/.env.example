# Backend Laravel — référence des variables
# En production (Dokploy), toutes ces variables sont injectées via docker-compose.yml
# Ce fichier est uniquement utile pour le développement local (cp .env.example .env)

APP_NAME=RestoQR
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.votredomaine.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=restodb
DB_USERNAME=restouser
DB_PASSWORD=strong_password_here

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=app.votredomaine.com
SESSION_DOMAIN=app.votredomaine.com

FILESYSTEM_DISK=public
FRONTEND_URL=https://app.votredomaine.com
