# ══════════════════════════════════════════════════════════════════════════════
# RestoQR — Variables d'environnement (Dokploy)
# Copier dans Dokploy > Application > Environment Variables
# ══════════════════════════════════════════════════════════════════════════════

# ── Domaine ──────────────────────────────────────────────────────────────────
# Votre domaine sans https:// ni slash final
DOMAIN=app.votredomaine.com

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=error

# Générer avec : php artisan key:generate --show
# Ou en ligne : https://generate-random.org/laravel-key-generator
APP_KEY=base64:VOTRE_CLE_ICI

# ── Base de données ───────────────────────────────────────────────────────────
DB_DATABASE=restodb
DB_USERNAME=restouser
DB_PASSWORD=mot_de_passe_fort_ici
DB_ROOT_PASSWORD=mot_de_passe_root_fort_ici

# ── Redis ─────────────────────────────────────────────────────────────────────
# Laisser null si Redis sans mot de passe (cas par défaut)
REDIS_PASSWORD=null
